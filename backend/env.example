# Copy this file to backend/.env and adjust.
HOST=127.0.0.1
PORT=8000

# IMPORTANT: keep the Qdrant folder OUTSIDE OneDrive (sync can lock or corrupt it)
QDRANT_PATH=C:\serc_qdrant_v2
QDRANT_COLLECTION=serc_security_knowledge
TOP_K_RETRIEVAL=5

# Offline mode needs no keys. For live answers set MOCK_LLM_MODE=false and add your OpenAI key HERE (never in chat).
# FREE option (no billing, no card): a Google Gemini key from https://aistudio.google.com/apikey
#   OPENAI_API_KEY=<your Gemini key>
#   OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=<a current Flash model name shown in AI Studio>
# FREE option 2: GitHub Models (uses a GitHub token, no card)
#   OPENAI_API_KEY=<fine-grained personal access token with Models: Read-only>
#   OPENAI_API_BASE=https://models.github.ai/inference
#   OPENAI_MODEL=openai/gpt-4o-mini      (or openai/gpt-4o, the paper's model; check the model catalog)
# (these variables work with any OpenAI-compatible provider). Screenshots use the same model.
# PIXTRAL_API_KEY is optional and can stay empty.
MOCK_LLM_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
PIXTRAL_API_KEY=
PIXTRAL_MODEL=pixtral-12b-2409

# ---- Login ----
# The first account is created on the first start, only when no users exist yet.
# If ADMIN_PASSWORD is empty, a random password is generated and printed once in the server console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: a long random string used to sign sessions. If empty, one is created in backend/data/.session_secret
SECRET_KEY=
SESSION_HOURS=8
# Set to true when SERC is served over HTTPS
COOKIE_SECURE=false
# More users:  python backend/scripts/create_user.py <name>

# Synchronized dataset: how much of the knowledge base to keep in step with data_sources/
#   quick = the ATT&CK techniques used by the sample alerts (default),  full = all of ATT&CK
DATASET_SCOPE=quick
DATASET_INCLUDE_REV2=false
